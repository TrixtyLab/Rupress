{
  "name": "@trixtylab/rupress",
  "version": "1.0.1",
  "description": "HTTP server written in Rust (Tokio + Hyper) with a declarative API, the complete HTTP status system and first class support for React and Vite",
  "keywords": [
    "rupress",
    "http",
    "server",
    "rust",
    "hyper",
    "tokio",
    "napi",
    "react",
    "vite",
    "spa",
    "websocket"
  ],
  "homepage": "https://github.com/TrixtyLab/Rupress#readme",
  "bugs": {
    "url": "https://github.com/TrixtyLab/Rupress/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrixtyLab/Rupress.git",
    "directory": "/"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "JmaxDev",
  "main": "./index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.js"
    },
    "./http": {
      "types": "./dist/index.d.ts",
      "import": "./dist/http.js"
    },
    "./errors": {
      "types": "./dist/index.d.ts",
      "import": "./dist/errors.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "dist",
    "doc",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.js",
    "build:release": "node ./scripts/build.js --release",
    "build:js": "node ./scripts/build.js --js-only",
    "prepack": "node ./scripts/build.js --js-only --require-all",
    "dev": "node ./test/index.js",
    "test": "node ./test/run.js",
    "test:http": "node ./test/http_statuses.test.js",
    "test:api": "node ./test/api.test.js",
    "test:config": "node ./test/config.test.js",
    "test:protocol": "node ./test/protocol.test.js",
    "test:auth": "node ./test/auth.test.js",
    "test:validation": "node ./test/validation.test.js",
    "test:regressions": "node ./test/regressions.test.js",
    "test:frontend": "node ./test/frontend.test.js",
    "test:security": "node ./test/security.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12"
  }
}
